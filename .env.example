# ---------- Asatalk environment (everything optional) ----------

# Public URL of the app (used in metadata and share links)
NEXT_PUBLIC_APP_URL=https://asatalk.vercel.app

# Database. Defaults live in src/lib/server/api.ts and point at the shared
# Asa project; the anon key is public by design — every table is private and
# all access goes through SECURITY DEFINER api_* functions.
ASATALK_SUPABASE_URL=
ASATALK_SUPABASE_ANON_KEY=

# Calls: TURN relay. STUN alone only connects peers on the same network —
# set these for calls between different networks (mobile data ↔ Wi-Fi).
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_PASS=

# Sign-in codes: POST {identifier, kind, code} to your SMS / email provider.
# Without it the code is shown in the app (demo mode) — set it before launch.
ASATALK_OTP_WEBHOOK_URL=
ASATALK_OTP_WEBHOOK_TOKEN=

# Web push (new messages and incoming calls while the app is closed).
# Generate a pair with:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log('PUBLIC :',publicKey.export({type:'spki',format:'der'}).subarray(-65).toString('base64url'));console.log('PRIVATE:',privateKey.export({format:'jwk'}).d)"
# Keep the private key out of the repository — it is the only thing that lets
# anyone push to your users. Without both, push is simply off and the app
# falls back to in-page notifications.
ASATALK_VAPID_PUBLIC_KEY=
ASATALK_VAPID_PRIVATE_KEY=
ASATALK_VAPID_SUBJECT=mailto:you@example.com

# Optional link back to Asameet from the drawer; hidden when unset.
NEXT_PUBLIC_ASAMEET_URL=

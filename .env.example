# ---------- Asameet environment (everything optional) ----------

# Public URL of the app (used in metadata / share links)
NEXT_PUBLIC_APP_URL=https://asameet.online

# AI assistant (meeting minutes / summaries / brainstorming).
# Without a key the /api/ai route serves polished demo output.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
ASAMEET_AI_MODEL=

# Point at a different database project (defaults live in src/lib/server/api.ts;
# the anon key is public by design — access control happens inside Postgres).
ASAMEET_SUPABASE_URL=
ASAMEET_SUPABASE_ANON_KEY=

# Asatalk calls: optional TURN relay for strict NATs (comma-separated urls).
# Required for calls between different networks (WebRTC relay).
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_PASS=

# Asatalk one-time codes: POST {identifier, kind, code} to your SMS/email provider.
# Without it the code is shown in the app (demo mode).
ASATALK_OTP_WEBHOOK_URL=
ASATALK_OTP_WEBHOOK_TOKEN=

# Asatalk web push (new messages and incoming calls while the app is closed).
# The public half ships as a default in src/lib/server/push.ts — it is handed
# to every browser that subscribes. Only the private half is a secret, and
# without it push is simply off and the app falls back to in-page notices.
# Generate a pair with:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log('PUBLIC :',publicKey.export({type:'spki',format:'der'}).subarray(-65).toString('base64url'));console.log('PRIVATE:',privateKey.export({format:'jwk'}).d)"
ASATALK_VAPID_PRIVATE_KEY=
ASATALK_VAPID_PUBLIC_KEY=
ASATALK_VAPID_SUBJECT=mailto:you@example.com
